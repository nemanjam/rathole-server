[server]
bind_addr = "0.0.0.0:2333"

[server.transport]
type = "noise"

[server.transport.noise]
local_private_key = "private_key"

# separated based on token
# ports MUST be different
# tokens MUST be different

# mini pc
[server.services.mpc-traefik-http]
token = "secret_token_1"
bind_addr = "0.0.0.0:5080"

[server.services.mpc-traefik-https]
token = "secret_token_1"
bind_addr = "0.0.0.0:5443"

# opi
[server.services.opi-traefik-http]
token = "secret_token_2"
bind_addr = "0.0.0.0:5081"

[server.services.opi-traefik-https]
token = "secret_token_2"
bind_addr = "0.0.0.0:5444" 

# rpi
[server.services.rpi-traefik-http]
token = "secret_token_3"
bind_addr = "0.0.0.0:5082"

[server.services.rpi-traefik-https]
token = "secret_token_3"
bind_addr = "0.0.0.0:5445" 